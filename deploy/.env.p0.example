# Copy to .env.p0 (ignored by Git); generate unique random values.
DETECTOR_WORKER_ID=detector-1
MQTT_ENABLED=true
MQTT_USERNAME=detector-1
MQTT_PASSWORD=replace_with_random_32_characters
MQTT_BACKEND_USERNAME=railway-backend
MQTT_BACKEND_PASSWORD=replace_with_other_random_32_characters
EMQX_DASHBOARD_PASSWORD=replace_with_other_random_32_characters
RAILWAY_EMQX_COOKIE=replace_with_other_random_32_characters
PREVIEW_SERVICE_KEY=replace_with_other_random_48_characters
CAMERA_ALLOWED_HOSTS=127.0.0.1,localhost
PREVIEW_ALLOWED_ORIGINS=https://your-server-name
# Production cross-host MQTT: mount a trusted CA and enable the TLS listener.
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_BACKEND_URI=ssl://localhost:8883
MQTT_CA_FILE=/absolute/path/to/ca.crt
MQTT_SERVER_CERT=/absolute/path/to/server.crt
MQTT_SERVER_KEY=/absolute/path/to/server.key
MQTT_ALLOW_LOCAL_PLAINTEXT=false
SESSION_COOKIE_SECURE=true
ALLOW_LEGACY_MD5_LOGIN=false
FLASK_HOST=127.0.0.1
BACKEND_INTERNAL_URL=http://127.0.0.1:8080/api
# Keep these addresses aligned when another project occupies 8080.
SERVER_PORT=8080
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# Separate project network; Docker allocates an available subnet.
RAILWAY_DOCKER_NETWORK=railway-monitoring-p0
# Independent detector evidence upload identity; never share PREVIEW_SERVICE_KEY.
EVIDENCE_SERVICE_KEY=
EVIDENCE_INGEST_URL=http://127.0.0.1:8080/api
EVIDENCE_ROOT=workspace/runtime/risk-evidence
EVIDENCE_MAX_BYTES=1073741824
# Optional CA file for a private HTTPS evidence ingress.
EVIDENCE_CA_FILE=
# Media budget is decimal bytes; 30 days is the requested one-month policy.
SOURCE_RECORDING_ENABLED=true
SOURCE_SEGMENT_SECONDS=30
FULL_RECORDING_ROOT=workspace/runtime/full-recordings
RECORDING_MAX_BYTES=2000000000000
RECORDING_RETENTION_DAYS=30
RECORDING_MIN_FREE_BYTES=1073741824
DETECTOR_STALL_SECONDS=120
# Burst queue for high-resolution keyframes; memory/concurrent readers still need sizing.
MEDIA_WRITE_QUEUE_SIZE=8192
SAMPLED_RECORDING_ENABLED=false
# Shared inference frames and optional VFR target-window sample archives.
LIVE_RESULTS_ENABLED=true
LIVE_RESULTS_MAX_FPS=2
ANALYSIS_RECORDING_ENABLED=true
ANALYSIS_MAX_SAMPLE_FPS=2
# Decoder backlog growth is not camera-to-client absolute latency.
VIDEO_DECODE_THREADS=4
VIDEO_MAX_RELATIVE_LAG_MS=2000
# Station inbox is always enabled. External channels stay unconfigured until
# these private credentials and explicit destinations are supplied.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_KEY=
NOTIFY_ALLOW_LOOPBACK=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_RECIPIENTS=
SMS_MIN_RISK_LEVEL=3
SMS_TEMPLATE_PARAMS_JSON='{"event":"${type}","level":"${level}","time":"${time}"}'
