# 应用标题
VITE_APP_TITLE = 铁路沿线监测系统

# API 地址
VITE_API_URL=/api

# 文件服务地址
VITE_FILE_URL=/file-api

# 算法服务地址
VITE_ALGO_URL=/algo

# 环境变量
VITE_BASE_API=/api
VITE_FILE_API=/file
VITE_ALGO_API=/algo

# 未显式配置时，WebSocket 和 MQTT 使用浏览器当前访问的主机
VITE_MQTT_WS_PORT=8083

# 高德地图 Web JS API（本机开发建议写入不会提交的 .env.local）
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
